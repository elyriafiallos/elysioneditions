---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{ SITE_TITLE }</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="https://elyriafiallos.com">The Author</HeaderLink>
			<HeaderLink href="https://bluehournovel.com">The Book</HeaderLink>
			<HeaderLink href="https://thehourseries.com">The Series</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #0b1220;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		letter-spacing: 0.02em;
	}
	h2 a {
		color: #e8e2d4;
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.25em;
	}
	nav a {
		padding: 1em 0.6em;
		color: #b8a07a;
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-size: 0.85rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	nav a:hover {
		color: #e8e2d4;
		border-bottom-color: #b8a07a;
	}
	nav a.active {
		color: #e8e2d4;
		border-bottom-color: #b8a07a;
	}
	@media (max-width: 720px) {
		nav {
			justify-content: center;
		}
		nav a {
			padding: 0.7em 0.45em;
			font-size: 0.78rem;
		}
	}
</style>
