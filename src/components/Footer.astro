<style>
	footer {
		padding: 3.5em 1.5em 3em;
		background: #0b1220;
		color: #9aa4b2;
		text-align: center;
		font-size: 0.9rem;
	}
	footer .disclosure {
		max-width: 620px;
		margin: 0 auto 2.5em;
		padding: 0.9em 1.2em;
		border-left: 2px solid #b8a07a;
		background: rgba(184, 160, 122, 0.08);
		color: #c8cdd6;
		font-style: italic;
		text-align: left;
	}
	footer h3 {
		color: #b8a07a;
		font-size: 0.75rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		margin: 0 0 1em;
		font-weight: 400;
	}
	footer ul {
		list-style: none;
		padding: 0;
		margin: 0 auto 2.5em;
		max-width: 720px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
		gap: 1.4em 1.8em;
		text-align: left;
	}
	footer li a {
		display: block;
		color: #e8e2d4;
		text-decoration: none;
		font-size: 0.95rem;
		margin-bottom: 0.2em;
	}
	footer li a:hover {
		color: #b8a07a;
	}
	footer li .blurb {
		display: block;
		font-size: 0.78rem;
		color: #7d8796;
		line-height: 1.45;
	}
	footer .legal p {
		margin: 0.3em 0;
	}
	footer .note {
		color: #b8a07a;
		font-style: italic;
	}
</style>
